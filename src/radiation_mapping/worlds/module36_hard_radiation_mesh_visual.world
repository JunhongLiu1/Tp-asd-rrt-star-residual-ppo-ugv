<?xml version='1.0' encoding='utf-8'?>
<sdf version="1.6">

  <world name="dem_inspired_benchmark_world">

    <gravity>0 0 -9.81</gravity>

    
    <plugin name="gazebo_ros_state" filename="libgazebo_ros_state.so">
      <ros>
        <namespace>/</namespace>
      </ros>
      <update_rate>10.0</update_rate>
    </plugin>


    <physics name="default_physics" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>

      <ode>
        <solver>
          <type>quick</type>
          <iters>100</iters>
          <sor>1.3</sor>
        </solver>

        <constraints>
          <cfm>0.0</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>0.1</contact_max_correcting_vel>
          <contact_surface_layer>0.001</contact_surface_layer>
        </constraints>
      </ode>
    </physics>

    <scene>
      <ambient>0.75 0.75 0.75 1</ambient>
      <background>0.82 0.82 0.84 1</background>
      <shadows>false</shadows>
    </scene>

    <light name="terrain_light" type="directional">
      <cast_shadows>false</cast_shadows>

      <pose>0 0 30 0 0 0</pose>

      <diffuse>0.85 0.85 0.85 1</diffuse>
      <specular>0.05 0.05 0.05 1</specular>

      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>

      <direction>-0.5 0.3 -1.0</direction>
    </light>

    <gui fullscreen="0">
      <camera name="user_camera">
        <pose>
          -34.500000
          -34.500000
          22.500000
          0 0.48 0.78
        </pose>

        <view_controller>orbit</view_controller>
      </camera>
    </gui>

    <model name="dem_inspired_terrain">
      <static>true</static>

      <link name="terrain_link">

        <collision name="terrain_collision">
          <geometry>
            <heightmap>
              <uri>file:///home/i/terrain_radiation_ws/src/radiation_mapping/dem/processed/dem_terrain_hard_husky_015_513.png</uri>

              <size>
                19.047619
                30.000000
                1.514038
              </size>

              <pos>0 0 0</pos>
              <sampling>1</sampling>
            </heightmap>
          </geometry>

          <surface>
            <friction>
              <ode>
                <mu>0.9</mu>
                <mu2>0.9</mu2>
              </ode>
            </friction>

            <contact>
              <ode>
                <kp>10000000</kp>
                <kd>10000</kd>
                <max_vel>0.2</max_vel>
                <min_depth>0.0</min_depth>
              </ode>
            </contact>
          </surface>
        </collision>

        <visual name="terrain_visual">

          <cast_shadows>false</cast_shadows>

          <geometry>
            <mesh><uri>file:///home/i/terrain_radiation_ws/src/radiation_mapping/dem/processed/dem_terrain_hard_husky_visual.stl</uri><scale>1 1 1</scale></mesh></geometry>

        <material><ambient>0.82 0.82 0.78 1</ambient><diffuse>0.90 0.90 0.86 1</diffuse><specular>0.02 0.02 0.02 1</specular></material></visual>

      </link>
    </model>

  
    
    <model name="radiation_source_alpha">
      <static>true</static>
      <pose>-2.5 3.5 1.20 0 0 0</pose>

      <link name="source_link">
        <visual name="source_visual">
          <geometry>
            <sphere>
              <radius>0.30</radius>
            </sphere>
          </geometry>

          <material>
            <ambient>1.0 0.05 0.05 1</ambient>
            <diffuse>1.0 0.05 0.05 1</diffuse>
            <emissive>0.8 0.02 0.02 1</emissive>
          </material>
        </visual>
      </link>
    </model>

    
    <model name="radiation_source_beta">
      <static>true</static>
      <pose>4.0 -4.5 1.20 0 0 0</pose>

      <link name="source_link">
        <visual name="source_visual">
          <geometry>
            <sphere>
              <radius>0.25</radius>
            </sphere>
          </geometry>

          <material>
            <ambient>1.0 0.45 0.0 1</ambient>
            <diffuse>1.0 0.45 0.0 1</diffuse>
            <emissive>0.8 0.25 0.0 1</emissive>
          </material>
        </visual>
      </link>
    </model>

    
    <plugin name="radiation_world_plugin" filename="libgazebo_radiation_world_plugin.so">

      <ros>
        <namespace>/</namespace>
      </ros>

      <target_model>husky</target_model>

      <background_dose_rate_usv_h>
        0.05
      </background_dose_rate_usv_h>

      <publish_rate_hz>10.0</publish_rate_hz>

      <use_3d_distance>false</use_3d_distance>
      <publish_radiation_map>
        true
      </publish_radiation_map>

      <terrain_map_topic>
        /terrain_impedance_map
      </terrain_map_topic>

      <radiation_map_topic>
        /radiation_map
      </radiation_map_topic>

      <radiation_map_saturation_usv_h>
        8.0
      </radiation_map_saturation_usv_h>

      <radiation_map_use_3d_distance>
        false
      </radiation_map_use_3d_distance>

      <radiation_map_z_m>
        0.0
      </radiation_map_z_m>


      <dose_rate_topic>
        /radiation/dose_rate_usv_h
      </dose_rate_topic>

      <accumulated_dose_topic>
        /radiation/accumulated_dose_usv
      </accumulated_dose_topic>

      <nearest_distance_topic>
        /radiation/nearest_source_distance_m
      </nearest_distance_topic>

      <source>
        <model_name>
          radiation_source_alpha
        </model_name>

        <strength_usv_h_m2>
          6.0
        </strength_usv_h_m2>

        <softening_radius_m>
          0.60
        </softening_radius_m>

        <attenuation_per_m>
          0.04
        </attenuation_per_m>
      </source>

      <source>
        <model_name>
          radiation_source_beta
        </model_name>

        <strength_usv_h_m2>
          4.0
        </strength_usv_h_m2>

        <softening_radius_m>
          0.80
        </softening_radius_m>

        <attenuation_per_m>
          0.04
        </attenuation_per_m>
      </source>
    </plugin>

  </world>

</sdf>