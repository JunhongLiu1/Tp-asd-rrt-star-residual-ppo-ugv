<?xml version="1.0" ?>
<sdf version="1.6">

  <world name="module33_full_snowex_scaled_world">

    <include>
      <uri>model://sun</uri>
    </include>

    <gravity>0 0 -9.81</gravity>

    <physics name="default_physics" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <scene>
      <ambient>0.55 0.55 0.55 1</ambient>
      <background>0.78 0.78 0.82 1</background>
      <shadows>true</shadows>
    </scene>

    <gui fullscreen="0">
      <camera name="user_camera">
        <pose>
          -58.000000
          -58.000000
          42.000000
          0 0.52 0.78
        </pose>
        <view_controller>orbit</view_controller>
      </camera>
    </gui>

    <model name="complete_scaled_snowex_terrain">
      <static>true</static>

      <link name="terrain_link">

        <collision name="terrain_collision">
          <geometry>
            <heightmap>

              <uri>file:///home/i/terrain_radiation_ws/src/radiation_mapping/dem/processed/snowex_full_zero_513_40m.tif</uri>

              <!--
                X, Y and Z were generated using one common
                scale factor. The full source DEM is retained.
              -->
              <size>
                25.396825
                40.000000
                3.508146
              </size>

              <pos>0 0 0</pos>
              <sampling>1</sampling>

            </heightmap>
          </geometry>

          <surface>
            <friction>
              <ode>
                <mu>0.9</mu>
                <mu2>0.9</mu2>
              </ode>
            </friction>

            <contact>
              <ode>
                <kp>1000000</kp>
                <kd>1</kd>
              </ode>
            </contact>
          </surface>
        </collision>

        <visual name="terrain_visual">
          <geometry>
            <heightmap>

              <uri>file:///home/i/terrain_radiation_ws/src/radiation_mapping/dem/processed/snowex_full_zero_513_40m.tif</uri>

              <size>
                25.396825
                40.000000
                3.508146
              </size>

              <pos>0 0 0</pos>
              <sampling>1</sampling>

              <!--
                The hillshade was generated from the same complete
                processed DEM and is used only as a visual texture.
              -->
              <texture>
                <diffuse>file:///home/i/terrain_radiation_ws/src/radiation_mapping/dem/preview/snowex_full_hillshade_40m.png</diffuse>

                <normal>
                  file://media/materials/textures/flat_normal.png
                </normal>

                <size>40.000000</size>
              </texture>

            </heightmap>
          </geometry>
        </visual>

      </link>
    </model>

  </world>

</sdf>
